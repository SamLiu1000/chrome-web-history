{
  "manifest_version": 3,
  "name": "浏览库",
  "short_name": "浏览库",
  "version": "1.2.7",
  "description": "本地个人浏览库：可搜索、可分类、可备份；标签页收藏（可与 OneTab 互导、支持 Cloudflare 端到端加密云同步）、意外关闭找回。",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "tabs",
    "storage",
    "favicon",
    "bookmarks",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "alarms"
  ],
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开浏览库",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "pages/dashboard.html#settings",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
